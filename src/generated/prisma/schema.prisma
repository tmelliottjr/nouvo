generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model account {
  id                    String    @id @db.VarChar(36)
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String    @db.VarChar(36)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(0)
  refreshTokenExpiresAt DateTime? @db.DateTime(0)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @db.DateTime(0)
  updatedAt             DateTime  @db.DateTime(0)
  user                  user      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "account_ibfk_1")
}

model folders {
  id            String    @id @db.VarChar(36)
  name          String    @db.VarChar(255)
  user_id       String    @db.VarChar(36)
  parent_id     String?   @db.VarChar(36)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  folders       folders?  @relation("foldersTofolders", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "folders_ibfk_2")
  other_folders folders[] @relation("foldersTofolders")
  user          user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "folders_ibfk_3")
  notes         notes[]

  @@index([parent_id], map: "parent_id")
  @@index([user_id], map: "user_id")
}

model note_tags {
  note_id String @db.VarChar(36)
  tag_id  String @db.VarChar(36)
  notes   notes  @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "note_tags_ibfk_1")
  tags    tags   @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "note_tags_ibfk_2")

  @@id([note_id, tag_id])
  @@index([tag_id], map: "tag_id")
}

model notes {
  id         String      @id @db.VarChar(36)
  name       String      @db.VarChar(255)
  content    String?     @db.Text
  user_id    String      @db.VarChar(36)
  parent_id  String?     @db.VarChar(36)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  updated_at DateTime?   @default(now()) @db.Timestamp(0)
  is_pinned  Boolean?    @default(false)
  is_public  Boolean?    @default(false)
  note_tags  note_tags[]
  folders    folders?    @relation(fields: [parent_id], references: [id], onUpdate: NoAction, map: "fk_notes_folder")
  user       user        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notes_ibfk_1")
  shares     shares[]

  @@index([parent_id], map: "fk_notes_folder")
  @@index([is_public], map: "idx_notes_public")
  @@index([user_id], map: "user_id")
}

model pending_shares {
  id         String                    @id @db.VarChar(36)
  note_id    String                    @db.VarChar(255)
  user_email String                    @db.VarChar(255)
  permission pending_shares_permission @default(read)
}

model session {
  id        String   @id @db.VarChar(36)
  expiresAt DateTime @db.DateTime(0)
  token     String   @unique(map: "token") @db.VarChar(255)
  createdAt DateTime @db.DateTime(0)
  updatedAt DateTime @db.DateTime(0)
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String   @db.VarChar(36)
}

model shares {
  id         String             @id @db.VarChar(36)
  note_id    String             @db.VarChar(36)
  user_id    String             @db.VarChar(36)
  created_at DateTime?          @default(now()) @db.Timestamp(0)
  expires_at DateTime?          @db.Timestamp(0)
  permission shares_permission?
  notes      notes              @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "shares_ibfk_1")
  user       user               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "shares_ibfk_2")

  @@index([note_id], map: "note_id")
  @@index([user_id], map: "user_id")
}

model tags {
  id         String      @id @db.VarChar(36)
  name       String      @db.VarChar(255)
  user_id    String      @db.VarChar(36)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
  note_tags  note_tags[]
  user       user        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tags_ibfk_1")

  @@unique([user_id, name], map: "user_tag_unique")
}

model user {
  id                          String                         @id @db.VarChar(36)
  name                        String                         @db.Text
  email                       String                         @unique(map: "email") @db.VarChar(255)
  emailVerified               Boolean
  image                       String?                        @db.Text
  createdAt                   DateTime                       @db.DateTime(0)
  updatedAt                   DateTime                       @db.DateTime(0)
  folders                     folders[]
  notes                       notes[]
  shares                      shares[]
  tags                        tags[]
  accounts                    account[]
  calendars                   calendar[]
  calendarIntegrationSettings calendar_integration_settings?
}

model verification {
  id         String    @id @db.VarChar(36)
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime  @db.DateTime(0)
  createdAt  DateTime? @db.DateTime(0)
  updatedAt  DateTime? @db.DateTime(0)
}

enum pending_shares_permission {
  read
  write
}

enum shares_permission {
  read
  write
}

model calendar {
  id            String   @id @db.VarChar(36)
  user_id       String   @db.VarChar(36)
  provider_id   String   @db.VarChar(36)
  calendar_name String   @db.VarChar(255)
  calendar_id   String   @db.VarChar(255)
  is_primary    Boolean  @default(false)
  is_enabled    Boolean  @default(true)
  color         String?  @db.VarChar(7)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
  user          user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, provider_id, calendar_id], name: "unique_user_calendar")
  @@index([user_id], map: "user_id")
  @@index([provider_id], map: "provider_id")
}

model calendar_integration_settings {
  id         String   @id @db.VarChar(36)
  user_id    String   @unique @db.VarChar(36)
  is_enabled Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
